# Supply-chain mitigation: refuse to install package versions younger
# than 7 days. Pnpm-only setting (>=10). Buys time for compromised
# releases to be detected and unpublished before they reach the lockfile.
minimum-release-age=10080

# Add deliberate exemptions here if you ever truly need a fresh release.
# minimum-release-age-exclude[]=my-internal-pkg
