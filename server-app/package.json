{
  "name": "@agent-server/core",
  "version": "3.0.0",
  "description": "Lightweight orchestration server for Claude Code and Codex agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agent-server": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@types/node": "^25.3.5",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "4.1.5",
    "eslint": "9.39.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.53.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.71",
    "@anthropic-ai/sdk": "^0.78.0",
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.0",
    "@openai/codex-sdk": "^0.144.1",
    "@slack/socket-mode": "^3.0.0",
    "@slack/web-api": "^8.0.0",
    "@supabase/supabase-js": "^2.98.0",
    "commander": "^14.0.3",
    "cron-parser": "^5.5.0",
    "dotenv": "^17.3.1",
    "grammy": "^1.41.1",
    "hono": "^4.12.5",
    "ws": "^8.19.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  }
}
